#!/bin/sh

#   -------------------------------------------------------------
#   Git workflow :: resend (git commit --amend + push)
#   - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
#   Project:        Wynter
#   Description:    Amend the current commit, keeping the current message,
#                   then pushes it to relevant remote.
#
#                   The goal is to share the branch to a remote development or
#                   deployment server to test or deploy.
#
#                   At Nasqueron, works with datacube remote to share branches.
#                   Elsewhere, works with origin remote (e.g. GitLab/GitHub).
#
#                   Afterwards, you can use `git receive` on the remote machine.
#   License:        BSD-2-Clause
#   Source file:    roles/workstation/userland-home/files/dereckson/bin/git-resend
#   -------------------------------------------------------------
#
#   <auto-generated>
#       This file is managed by Wynter SaltStack repository.
#
#       Changes to this file may cause incorrect behavior
#       and will be lost if the state is redeployed.
#   </auto-generated>
#   -------------------------------------------------------------

set -e

CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
DEFAULT_BRANCH=$(git get-default-branch)

if [ "$CURRENT_BRANCH" = "$DEFAULT_BRANCH" ]; then
        echo "You're on the default branch '$DEFAULT_BRANCH'. This workflow is intended for feature branches."
        exit 1
fi

git add -p
git commit --amend --no-edit

# Case 1. A remote called "datacube" exists.
if git remote get-url datacube >/dev/null 2>&1; then
    git push datacube "$CURRENT_BRANCH" -f
    exit 0
fi

# Case 2. This repository has a special workflow.
if git remote -v | grep -q 'devcentral\.nasqueron\.org'; then
    echo "To share a DevCentral branch, you can use \`arc diff\` or add a datacube remote."
    exit 1
fi

# Case 3. We can safely push to GitHub for testing
git push origin "$CURRENT_BRANCH" -f
