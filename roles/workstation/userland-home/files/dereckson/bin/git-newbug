#!/bin/sh

#   -------------------------------------------------------------
#   Git workflow :: switch to new feature branch
#   - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
#   Project:        Wynter
#   Description:    Update the default branch with origin changes,
#                   then create a new feature branch from there
#   License:        BSD-2-Clause
#   Source file:    roles/workstation/userland-home/files/dereckson/bin/git-newbug
#   -------------------------------------------------------------
#
#   <auto-generated>
#       This file is managed by Wynter SaltStack repository.
#
#       Changes to this file may cause incorrect behavior
#       and will be lost if the state is redeployed.
#   </auto-generated>
#   -------------------------------------------------------------

set -e

if [ $# -eq 0 ]; then
	echo "Usage: $(basename "$0") <name of the branch to create>"
	exit 1
fi

WORKING_BRANCH=$1
DEFAULT_BRANCH=$(git get-default-branch)

git switch "$DEFAULT_BRANCH"
git fetch --all
git pull --ff-only
git switch -c "$WORKING_BRANCH"
