#!/bin/sh

#   -------------------------------------------------------------
#   Git workflow :: rename-branch
#   - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
#   Project:        Wynter
#   Description:    Rename a local branch and its counterpart on the remote
#
#                   1. Rename the local branch
#                   2. Delete the old branch on the remote
#                   3. Unset upstream so git does not reuse the old name
#                   4. Push the new branch and set its upstream
#   Usage:          git rename-branch [<old-name>] <new-name> [<remote>]
#   Default values:                   <current>               origin
#                                     (or datacube if that remote exists)
#   License:        BSD-2-Clause
#   Source file:    roles/workstation/userland-home/files/dereckson/bin/git-rename-branch
#   -------------------------------------------------------------
#
#   <auto-generated>
#       This file is managed by Wynter SaltStack repository.
#
#       Changes to this file may cause incorrect behavior
#       and will be lost if the state is redeployed.
#   </auto-generated>
#   -------------------------------------------------------------

set -e

#   -------------------------------------------------------------
#   Arguments
#   - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

if [ $# -eq 0 ] || [ $# -gt 3 ]; then
    echo "Usage: $(basename "$0") [<old-name>] <new-name> [<remote>]"
    exit 1
fi

if [ $# -eq 1 ]; then
    OLD_NAME=$(git rev-parse --abbrev-ref HEAD)
    NEW_NAME=$1
elif [ $# -eq 2 ]; then
    OLD_NAME=$1
    NEW_NAME=$2
else
    OLD_NAME=$1
    NEW_NAME=$2
    REMOTE=$3
fi

if [ -z "$REMOTE" ]; then
    if git remote get-url datacube >/dev/null 2>&1; then
        REMOTE=datacube
    else
        REMOTE=origin
    fi
fi

#   -------------------------------------------------------------
#   Sanity checks
#   - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

if [ "$OLD_NAME" = "HEAD" ]; then
    echo "You are in detached HEAD state. Check out a branch first." >&2
    exit 2
fi

if [ "$OLD_NAME" = "$NEW_NAME" ]; then
    echo "Old and new branch names are identical: '$OLD_NAME'." >&2
    exit 4
fi

if ! git show-ref --verify --quiet "refs/heads/$OLD_NAME"; then
    echo "Local branch '$OLD_NAME' does not exist." >&2
    exit 8
fi

if git show-ref --verify --quiet "refs/heads/$NEW_NAME"; then
    echo "Local branch '$NEW_NAME' already exists." >&2
    exit 16
fi

if ! git remote get-url "$REMOTE" >/dev/null 2>&1; then
    echo "Remote '$REMOTE' does not exist." >&2
    exit 32
fi

#   -------------------------------------------------------------
#   Rename the local branch
#   - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

git branch -m "$OLD_NAME" "$NEW_NAME"

#   -------------------------------------------------------------
#   Delete the old branch on the remote
#   - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

git fetch "$REMOTE"

if git show-ref --verify --quiet "refs/remotes/$REMOTE/$OLD_NAME"; then
    git delete-remote-branch "$REMOTE" "$OLD_NAME"
fi

#   -------------------------------------------------------------
#   Prevent git from using the old upstream name on the next push
#   - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

if git rev-parse --abbrev-ref "$NEW_NAME@{upstream}" >/dev/null 2>&1; then
    git branch --unset-upstream "$NEW_NAME"
fi

#   -------------------------------------------------------------
#   Push the new branch and set its upstream
#   - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

git push "$REMOTE" -u "$NEW_NAME"
