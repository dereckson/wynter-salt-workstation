#!/bin/sh

#   -------------------------------------------------------------
#   Git workflow :: land
#   - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
#   Project:        Wynter
#   Description:    Land the last commit of the current branch to default branch
#                   [origin/main + current HEAD] -> [main] -> [origin/main]
#
#                   Inspired by `arc land` model and gerrit workflow
#   License:        BSD-2-Clause
#   Source file:    roles/workstation/userland-home/files/dereckson/bin/git-land
#   -------------------------------------------------------------
#
#   <auto-generated>
#       This file is managed by Wynter SaltStack repository.
#
#       Changes to this file may cause incorrect behavior
#       and will be lost if the state is redeployed.
#   </auto-generated>
#   -------------------------------------------------------------

set -e

CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
DEFAULT_BRANCH=$(git get-default-branch)

if [ "$CURRENT_BRANCH" = "$DEFAULT_BRANCH" ]; then
        echo "You're on the default branch '$DEFAULT_BRANCH'. This workflow is intended for feature branches."
        exit 1
fi

#   -------------------------------------------------------------
#   Commits lander
#   - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

land_commits()
{
    COMMITS_COUNT=$(git rev-list --count "$DEFAULT_BRANCH..$CURRENT_BRANCH")

    if [ "$COMMITS_COUNT" -eq 0 ]; then
        echo "There aren't any commits to land from '$CURRENT_BRANCH'."
        git switch "$CURRENT_BRANCH"
        exit 2
    fi

    # Are we perfectly linear off the default branch?
    if git merge-base --is-ancestor "$DEFAULT_BRANCH" "$CURRENT_BRANCH"; then
        # Case 1: Fast-forward to preserve hashes
        git merge --ff-only "$CURRENT_BRANCH"
    else
        # Case 2: We diverged/lag. Handle the rewrite.
        if [ "$COMMITS_COUNT" -eq 1 ]; then
            git cherry-pick "$CURRENT_BRANCH"
        else
            echo "Branch '$CURRENT_BRANCH' contains $COMMITS_COUNT commits:"
            echo
            git log --oneline --reverse "$DEFAULT_BRANCH..$CURRENT_BRANCH"
            echo

            printf "Land all %s commits? [y/N] " "$COMMITS_COUNT"
            read -r ANSWER

            case "$ANSWER" in
                y|Y)
                    COMMITS_RANGE=$(git rev-list --reverse "$DEFAULT_BRANCH..$CURRENT_BRANCH")
                    # shellcheck disable=SC2086 # split: one SHA per argument
                    git cherry-pick $COMMITS_RANGE
                    ;;
                *)
                    git switch "$CURRENT_BRANCH"
                    echo "Landing aborted."
                    exit 4
                    ;;
            esac
        fi
    fi
}

#   -------------------------------------------------------------
#   Integrate last commit to main branch
#   - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

git fetch --all
git switch "$DEFAULT_BRANCH"
if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
    echo "You have uncommitted changes. Please commit or stash them before landing." >&2
    git switch "$CURRENT_BRANCH"
    exit 8
fi
git pull --ff-only

land_commits

git push

#   -------------------------------------------------------------
#   Clean-up
#   Delete the local branch, and remove it from the staging remote.
#
#   For Nasqueron, branches are pushed to "datacube" for staging and
#   deployment testing. For standard GitHub projects (where origin is
#   the canonical remote for PRs), we fall back to "origin".
#   - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

git branch -D "$CURRENT_BRANCH"

if git remote get-url datacube >/dev/null 2>&1; then
    REMOTE=datacube
else
    REMOTE=origin
fi

git delete-remote-branch "$REMOTE" "$CURRENT_BRANCH"
