#!/bin/sh

#   -------------------------------------------------------------
#   Git utility :: delete-remote-branch
#   - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
#   Project:        Wynter
#   Description:    Delete a branch on specified remote Git repository
#                   Initially written to help rename master to main
#   Usage:          git delete-remote-branch [remote] [branch]
#   Default values:                           origin   master
