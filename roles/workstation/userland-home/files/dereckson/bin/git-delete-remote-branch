#       Changes to this file may cause incorrect behavior
#       and will be lost if the state is redeployed.
#   </auto-generated>
#   -------------------------------------------------------------

set -e

if [ "$#" -gt 1 ]; then
    remote=$1
    shift
else
    remote=origin
fi

if [ "$#" -gt 0 ]; then
    branch=$1
    shift
else
    branch=master
fi

git push "$remote" --delete "$branch"
