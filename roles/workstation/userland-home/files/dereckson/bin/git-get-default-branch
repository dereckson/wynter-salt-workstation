#!/bin/sh

#   -------------------------------------------------------------
#   Git helper :: get-default-branch
#   - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
#   Project:        Wynter
#   Description:    Determine by heuristics the default branch (e.g. main)
#   License:        BSD-2-Clause
#   Source file:    roles/workstation/userland-home/files/dereckson/bin/git-get-default-branch
#   -------------------------------------------------------------
#
#   <auto-generated>
#       This file is managed by Wynter SaltStack repository.
#
#       Changes to this file may cause incorrect behavior
#       and will be lost if the state is redeployed.
#   </auto-generated>
#   -------------------------------------------------------------

if [ $# -ne 0 ]; then
        >&2 echo "Usage: $(basename "$0")"
        exit 1
fi

#   -------------------------------------------------------------
#   Determine repository name
#   - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

REPO_PATH=$(git rev-parse --show-toplevel)
REPO_RETCODE=$?

if [ $REPO_RETCODE -ne 0 ]
then
    exit $REPO_RETCODE
fi;

REPO=$(basename "$REPO_PATH")

#   -------------------------------------------------------------
#   Try to determine the branch
#
#   Case 1. Exceptions for known repositories are hardcoded
#   Case 2. Read setting from arc configuration (will break if HEAD^)
#   Case 3. Assume default conventions: main if it exists / master as fallback
#   - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

if [ "$REPO" = "puppet" ]; then
    DEFAULT_BRANCH=production
elif [ "$REPO" = "pixelfed" ]; then
    DEFAULT_BRANCH=dev
elif [ -f "$REPO_PATH/.git/arc/default-relative-commit" ]; then
    DEFAULT_BRANCH=$(awk -F / '{print $(NF)}' "$REPO_PATH/.git/arc/default-relative-commit")
elif git show-ref --verify --quiet refs/heads/main; then
    DEFAULT_BRANCH=main
else
    DEFAULT_BRANCH=master
fi

echo "$DEFAULT_BRANCH"
