#!/bin/sh

#   -------------------------------------------------------------
#   Git workflow :: receive (git fetch + reset --hard)
#   - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
#   Project:        Wynter
#   Description:    Fetch remote branches, then sync the current branch
#                   at both index and working tree level (git reset --hard).
#
#                   The goal is to apply the changes from a branch on a remote
#                   development or deployment server from a local workstation.
#
#                   At Nasqueron, works with datacube remote to share branches.
#                   Elsewhere, works with origin remote (e.g. GitLab/GitHub).
#
#                   e.g. `git receive && salt-call saltutil.sync_modules && …`
#
#                   Beforehand, you can use `git resend` on the dev machine.
#   License:        BSD-2-Clause
#   Source file:    roles/workstation/userland-home/files/dereckson/bin/git-receive
#   -------------------------------------------------------------
#
#   <auto-generated>
#       This file is managed by Wynter SaltStack repository.
#
#       Changes to this file may cause incorrect behavior
#       and will be lost if the state is redeployed.
#   </auto-generated>
#   -------------------------------------------------------------

set -e

CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
DEFAULT_BRANCH=$(git get-default-branch)

if [ "$CURRENT_BRANCH" = "$DEFAULT_BRANCH" ]; then
        echo "You're on the default branch '$DEFAULT_BRANCH'. This workflow is intended for feature branches."
        exit 1
fi

git fetch --all

if git remote get-url datacube >/dev/null 2>&1; then
    REMOTE=datacube
else
    REMOTE=origin
fi

git reset --hard "$REMOTE/$CURRENT_BRANCH"
