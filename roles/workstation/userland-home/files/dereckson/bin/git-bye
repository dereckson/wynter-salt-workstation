#!/bin/sh

#   -------------------------------------------------------------
#   Git utility :: bye
#   - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
#   Project:        Wynter
#   Description:    Switch to default branch, update it if relevant, then delete
#                   current branch. Intended when code is merged remotely.
#
#                   Default branch is updated if there isn't any staged change
#                   and the working tree is clean.
#   License:        BSD-2-Clause
#   Source file:    roles/workstation/userland-home/files/dereckson/bin/git-bye
#   -------------------------------------------------------------
#
#   <auto-generated>
#       This file is managed by Wynter SaltStack repository.
#
#       Changes to this file may cause incorrect behavior
#       and will be lost if the state is redeployed.
#   </auto-generated>
#   -------------------------------------------------------------

set -e

CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
DEFAULT_BRANCH=$(git get-default-branch)

if [ "$CURRENT_BRANCH" = "$DEFAULT_BRANCH" ]; then
	echo "You're already on the default branch '$DEFAULT_BRANCH'."
	exit 1
fi

git switch "$DEFAULT_BRANCH"

if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
    echo "You have uncommitted changes. Please commit or stash them before landing." >&2
    git switch "$CURRENT_BRANCH"
    exit 8
fi
git pull --ff-only

git branch -D "$CURRENT_BRANCH"
